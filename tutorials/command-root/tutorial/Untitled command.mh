    "scriptType": "powershell",
    "content": "while ($true) {\r\n    $value = Get-Random -Minimum 1000 -Maximum 2000\r\n    Write-Output ('{0:F3}' -f ($value / 1000))\r\n    Start-Sleep -Seconds 1\r\n}",
